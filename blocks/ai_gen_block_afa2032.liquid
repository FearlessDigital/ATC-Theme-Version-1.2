{% doc %}
  @prompt
    Generate a 100% wide table with 31 rows and 3 columns. Give me the ability to update this table within the settings, and switch between full width, 75% width, and 50% width, Wrap this table in a dropdown that I can toggle off and on, Center the toggle label, switch the icon from an arrow to a plus sign, and use the same font as the body copy (Monsterrat)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editable-table-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 auto;
  }

  .ai-editable-table-{{ ai_gen_id }}--width-100 {
    max-width: 100%;
  }

  .ai-editable-table-{{ ai_gen_id }}--width-75 {
    max-width: 75%;
  }

  .ai-editable-table-{{ ai_gen_id }}--width-50 {
    max-width: 50%;
  }

  .ai-editable-table__toggle-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.cell_padding }}px;
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 16px;
    text-align: center;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
  }

  .ai-editable-table__toggle-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-editable-table__toggle-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .ai-editable-table__toggle-icon-{{ ai_gen_id }}.active {
    transform: rotate(45deg);
  }

  .ai-editable-table__content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-editable-table__content-{{ ai_gen_id }}.active {
    max-height: 10000px;
  }

  .ai-editable-table__table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
  }

  .ai-editable-table__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
  }

  .ai-editable-table__table-{{ ai_gen_id }} th,
  .ai-editable-table__table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-editable-table__table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-weight: 600;
  }

  .ai-editable-table__table-{{ ai_gen_id }} td {
    color: {{ block.settings.cell_text_color }};
  }

  .ai-editable-table__table-{{ ai_gen_id }} tbody tr:nth-child(even) {
    background-color: {{ block.settings.alternate_row_background }};
  }
{% endstyle %}

<editable-table-{{ ai_gen_id }}
  class="ai-editable-table-{{ ai_gen_id }} ai-editable-table-{{ ai_gen_id }}--width-{{ block.settings.table_width }}"
  {{ block.shopify_attributes }}
>
  <button
    class="ai-editable-table__toggle-{{ ai_gen_id }}"
    aria-expanded="{{ block.settings.default_open }}"
    type="button"
  >
    <span>{{ block.settings.toggle_label }}</span>
    <svg
      class="ai-editable-table__toggle-icon-{{ ai_gen_id }} {% if block.settings.default_open %}active{% endif %}"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
  </button>

  <div class="ai-editable-table__content-{{ ai_gen_id }} {% if block.settings.default_open %}active{% endif %}">
    <div class="ai-editable-table__table-wrapper-{{ ai_gen_id }}">
      <table class="ai-editable-table__table-{{ ai_gen_id }}">
        <thead>
          <tr>
            <th>{{ block.settings.header_col_1 }}</th>
            <th>{{ block.settings.header_col_2 }}</th>
            <th>{{ block.settings.header_col_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {% for i in (1..31) %}
            {% liquid
              assign col1_key = 'row_' | append: i | append: '_col_1'
              assign col2_key = 'row_' | append: i | append: '_col_2'
              assign col3_key = 'row_' | append: i | append: '_col_3'

              assign col1_value = block.settings[col1_key]
              assign col2_value = block.settings[col2_key]
              assign col3_value = block.settings[col3_key]
            %}
            <tr>
              <td>{{ col1_value }}</td>
              <td>{{ col2_value }}</td>
              <td>{{ col3_value }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</editable-table-{{ ai_gen_id }}>

<script>
  (function() {
    class EditableTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.toggle = this.querySelector('.ai-editable-table__toggle-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-editable-table__content-{{ ai_gen_id }}');
        this.icon = this.querySelector('.ai-editable-table__toggle-icon-{{ ai_gen_id }}');

        this.toggle.addEventListener('click', () => {
          const isActive = this.content.classList.contains('active');

          this.content.classList.toggle('active');
          this.icon.classList.toggle('active');
          this.toggle.setAttribute('aria-expanded', !isActive);
        });
      }
    }

    customElements.define('editable-table-{{ ai_gen_id }}', EditableTable{{ ai_gen_id }});
  })();
</script>

