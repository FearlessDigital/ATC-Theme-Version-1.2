{% doc %}
  @prompt
    Generate a 100% wide table with 3 columns. Give me the ability to update this table within the settings, and switch between full width, 75% width, and 50% width, Wrap this table in a dropdown that I can toggle off and on, switch the icon from an arrow to a plus sign, and use the same font as the body copy (Monsterrat Bold). Make the table title slightly larger than the column headings, and give me the ability to add or remove rows. Format the second column with italics and give me the ability to add a hyperlink to text in the third column., Give me the ability to change background colors and to add or remove rows within the table settings, Add 10 more rows, Make all the rows below the column headings use a normal font weight, not bold, Give me the ability to change the title text color and the column headings color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.wrapper_background_color }};
    padding: {{ block.settings.wrapper_padding }}px;
  }

  .ai-table-container-{{ ai_gen_id }} {
    width: {{ block.settings.table_width }};
    margin: 0 auto;
  }

  .ai-table-toggle-{{ ai_gen_id }} {
    width: 100%;
    background: none;
    border: none;
    padding: 16px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: {{ block.settings.type_body_font.family }}, {{ block.settings.type_body_font.fallback_families }};
    font-weight: {{ block.settings.type_body_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_text_color }};
    text-align: left;
  }

  .ai-table-toggle-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .ai-table-toggle-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.title_text_color }};
  }

  .ai-table-toggle-{{ ai_gen_id }}[aria-expanded="true"] .ai-table-toggle-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-table-content-{{ ai_gen_id }} {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
  }

  .ai-table-content-{{ ai_gen_id }}.active {
    max-height: 5000px;
  }

  .ai-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    margin-top: 16px;
    font-family: {{ block.settings.type_body_font.family }}, {{ block.settings.type_body_font.fallback_families }};
    background-color: {{ block.settings.table_background_color }};
  }

  .ai-table-{{ ai_gen_id }} thead th {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.type_body_font.weight }};
    padding: 12px;
    text-align: left;
    border-bottom: 2px solid {{ block.settings.border_color }};
    color: {{ block.settings.heading_text_color }};
    background-color: {{ block.settings.header_background_color }};
  }

  .ai-table-{{ ai_gen_id }} tbody td {
    padding: 12px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    color: {{ block.settings.text_color }};
    font-weight: normal;
  }

  .ai-table-{{ ai_gen_id }} tbody tr {
    background-color: {{ block.settings.row_background_color }};
  }

  .ai-table-{{ ai_gen_id }} tbody tr:nth-child(even) {
    background-color: {{ block.settings.row_alternate_background_color }};
  }

  .ai-table-{{ ai_gen_id }} tbody td:nth-child(2) {
    font-style: italic;
  }

  .ai-table-{{ ai_gen_id }} tbody tr:last-child td {
    border-bottom: none;
  }

  .ai-table-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-table-link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }
{% endstyle %}

<collapsible-table-{{ ai_gen_id }} class="ai-table-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-table-container-{{ ai_gen_id }}">
    {% if block.settings.enable_dropdown %}
      <button
        class="ai-table-toggle-{{ ai_gen_id }}"
        aria-expanded="false"
        aria-controls="ai-table-content-{{ ai_gen_id }}"
      >
        <span>{{ block.settings.table_title }}</span>
        <span class="ai-table-toggle-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </span>
      </button>
      <div class="ai-table-content-{{ ai_gen_id }}" id="ai-table-content-{{ ai_gen_id }}">
    {% else %}
      {% if block.settings.table_title != blank %}
        <div class="ai-table-toggle-{{ ai_gen_id }}" style="cursor: default;">
          <span>{{ block.settings.table_title }}</span>
        </div>
      {% endif %}
    {% endif %}

    <table class="ai-table-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th>{{ block.settings.column_1_heading }}</th>
          <th>{{ block.settings.column_2_heading }}</th>
          <th>{{ block.settings.column_3_heading }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..30) %}
          {% liquid
            assign col1_key = 'row_' | append: i | append: '_col_1'
            assign col2_key = 'row_' | append: i | append: '_col_2'
            assign col3_key = 'row_' | append: i | append: '_col_3'
            assign col3_link_key = 'row_' | append: i | append: '_col_3_link'

            assign col1_value = block.settings[col1_key]
            assign col2_value = block.settings[col2_key]
            assign col3_value = block.settings[col3_key]
            assign col3_link = block.settings[col3_link_key]
          %}

          {% if col1_value != blank or col2_value != blank or col3_value != blank %}
            <tr>
              <td>{{ col1_value }}</td>
              <td>{{ col2_value }}</td>
              <td>
                {% if col3_link != blank %}
                  <a href="{{ col3_link }}" class="ai-table-link-{{ ai_gen_id }}">{{ col3_value }}</a>
                {% else %}
                  {{ col3_value }}
                {% endif %}
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>

    {% if block.settings.enable_dropdown %}
      </div>
    {% endif %}
  </div>
</collapsible-table-{{ ai_gen_id }}>

<script>
  (function() {
    class CollapsibleTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.toggle = this.querySelector('.ai-table-toggle-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-table-content-{{ ai_gen_id }}');
        
        if (this.toggle && this.content) {
          this.toggle.addEventListener('click', () => this.toggleContent());
        }
      }

      toggleContent() {
        const isExpanded = this.toggle.getAttribute('aria-expanded') === 'true';
        this.toggle.setAttribute('aria-expanded', !isExpanded);
        this.content.classList.toggle('active');
      }
    }

    customElements.define('collapsible-table-{{ ai_gen_id }}', CollapsibleTable{{ ai_gen_id }});
  })();
</script>

