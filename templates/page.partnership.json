    "image_with_text_WL8MGt": {
      "type": "image-with-text",
      "blocks": {
        "heading_9eyfVT": {
          "type": "heading",
          "settings": {
            "heading_text": "1. Full guidance & training for truffle farming",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_mrTCQ8": {
          "type": "description",
          "settings": {
            "description_text": "<p>We help you navigate every major decision from the earliest planning discussions through orchard maturity, tailored to your specific situation, microclimate, and soil. That typically includes:</p><ul><li>High-level site and project review to understand your goals and constraints </li><li>Guidance on orchard layout and planting strategy for truffle production </li><li>Training on irrigation, ground cover, and orchard maintenance practices </li><li>Practical recommendations for day-to-day management as the orchard develops, specifically tailored to your local conditions. </li><li>Formulating a winning truffle dog strategy and sourcing dogs trained by some of the best trainers and most experienced truffle hunters in the world </li><li>Preparation for harvest operations once truffles begin to appear </li></ul><p>You are never left to interpret generic instructions on your own. You gain direct access to a team whose sole focus is truffle science and truffle orchards. Throughout, our commitment is to bring scientific rigor, accumulated experience, and practical judgment to each major decision point.</p>"
          }
        }
      },
      "block_order": [
        "heading_9eyfVT",
        "description_mrTCQ8"
