    "image_with_text_hH4qdY": {
      "type": "image-with-text",
      "blocks": {
        "heading_88actr": {
          "type": "heading",
          "settings": {
            "heading_text": "2. Codified best-practice program",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_eFkPrR": {
          "type": "description",
          "settings": {
            "description_text": "<p> Instead of one-off advice, you benefit from a structured program of best practices developed from truffle science and real-world orchards.</p><ul><li>A coherent framework for how to manage a truffle orchard over time </li><li>Recommendations that account for your region, conditions, and project goals. When it comes to truffles, there is no one-size-fits-all.</li><li>Periodic updates as our research and field experience identify refinements </li><li>Guidance to avoid common mistakes that can compromise long-term productivity </li></ul><p>The goal is not to overwhelm you with theory, but to translate complex science into clear, practical steps for your specific orchard.</p>"
          }
        }
      },
      "block_order": [
        "heading_88actr",
        "description_eFkPrR"
