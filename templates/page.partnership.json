    "image_with_text_j8dbRd": {
      "type": "image-with-text",
      "blocks": {
        "heading_my8WU8": {
          "type": "heading",
          "settings": {
            "heading_text": "Is an ATC partnership right for you?",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_yFNwGt": {
          "type": "description",
          "settings": {
            "description_text": "<p>The partnership is designed for growers who treat truffle cultivation as a serious agricultural investment, not a side project. </p><p><strong>You’re likely a good fit if: </strong></p><ul><li>You own or plan to own land in a region that may be suitable for Périgord black truffles. </li><li>You are planning a long-term project and are comfortable with a multi-year time horizon. </li><li>You value data, research, and structured guidance over trial-and-error. </li><li>You want an expert team that will challenge assumptions and help you make disciplined decisions. </li><li>You want to avoid the pitfalls that have historically rendered 98%+ of truffle orchards failures in North America. </li></ul><p>If you’re still assessing whether your land or target region might be suitable, we encourage you to start with our truffle fundamentals and suitability resources, then return to explore a potential partnership. </p>"
          }
        },
