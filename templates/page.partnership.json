    "image_with_text_hniNjC": {
      "type": "image-with-text",
      "blocks": {
        "heading_cFEaBm": {
          "type": "heading",
          "settings": {
            "heading_text": "3. Scientific monitoring",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_QwGAff": {
          "type": "description",
          "settings": {
            "description_text": "<p>Truffle orchards do not fail overnight. Problems usually develop slowly and invisibly—unless you know where to look.</p><p>As part of the partnership, we implement systematic monitoring of key indicators of orchard and root health. In practice, this can include: </p><ul><li>Periodic analysis of root systems to understand colonization and development </li><li>Review of soil and orchard conditions within truffle-ideal parameters </li><li>Identification of trends that signal emerging risks or opportunities </li><li>Actionable recommendations to adjust management before small issues become larger ones </li></ul><p>This is not casual observation. It is a structured feedback loop between your orchard and our scientific team, designed to support earlier, more informed interventions.</p>"
          }
        }
      },
      "block_order": [
        "heading_cFEaBm",
        "description_QwGAff"
      ],
