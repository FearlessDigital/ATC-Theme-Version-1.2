          "type": "image_column",
          "settings": {
            "image_column_image": "shopify://shop_images/Street_level_granularity.jpg",
            "title": "Street-Level Microclimate Data",
            "description": "<p>Detailed and localized suitability, down to nearly individual street level. <strong>Benefit</strong>: You can assess the microclimate for specific locations with accurate and granular data. </p>",
            "btn_label": "",
            "btn_link": "#"
          }
        },
        "image_column_GVrJ8U": {
          "type": "image_column",
          "settings": {
            "image_column_image": "shopify://shop_images/Climate_change.jpg",
            "title": "Integrates 50-Year Climate Change Data",
            "description": "<p>Climate change can turn suitable climate areas hostile for truffles. This map ensures this doesn't happen to you. <strong>Benefit</strong>: Your chosen location will enjoy optimal climate for truffles for at least the next 50 years.</p>",
            "btn_label": "",
            "btn_link": "#"
          }
        },
        "image_column_AcWtaB": {
          "type": "image_column",
          "settings": {
            "image_column_image": "shopify://shop_images/Search_by_address.jpg",
            "title": "Search Any Address",
            "description": "<p>Instant feasibility verification for any parcel, with no guessing or approximation. <strong>Benefit:</strong> You will see the exact suitability criterion for the address you're looking for, with high confidence in the data. </p>",
            "btn_label": "",
            "btn_link": "#"
          }
        },
        "image_column_dkqdmh": {
          "type": "image_column",
          "settings": {
            "image_column_image": "shopify://shop_images/Gradations.jpg",
            "title": "Clear Risk Levels",
            "description": "<p>Visual gradations to compare sites at a glance. Even within climatically suitable regions, this map shows differences in suitability. <strong>Benefit</strong>: Clearly understand the trade-offs and different risk levels between parcels.</p>",
            "btn_label": "",
            "btn_link": "#"
          }
        }
