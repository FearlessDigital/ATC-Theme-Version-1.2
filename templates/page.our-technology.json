    "rich_text_kf4gkR": {
      "type": "rich-text",
      "blocks": {
        "subheading_qi6RzK": {
          "type": "subheading",
          "settings": {
            "subheading_text": "A Major Truffle-Tree Pitfall"
          }
        },
        "heading_mggczd": {
          "type": "heading",
          "settings": {
            "heading_text": "Contamination",
            "heading_size": "h2",
            "enable_h1_tag": false
          }
        },
        "description_eDcWLg": {
          "type": "description",
          "settings": {
            "description_text": "<p>Inoculation relies on spores in truffles. The industry’s reality: <em><strong>T. melanosporum</strong></em><strong> is sometimes cut</strong> with cheaper species such as <em><strong>T. brumale</strong></em> or <em><strong>T. indicum</strong></em>. If contaminants enter an orchard, they will <strong>outcompete</strong> <em>T. melanosporum</em> over time—non-ATC growers have harvested these species tracing back to mistakes made in non-ATC nurseries. </p><p>To prevent this, <strong>ATC DNA-tests </strong><em><strong>every single </strong></em><strong>truffle used in our inoculation process</strong> and enforces strict chain-of-custody and nursery QC. This is a core reason we can <strong>guarantee sapling quality</strong> and protect the long-term integrity of your orchard. </p>"
          }
        },
        "button_GEmYDh": {
          "type": "button",
          "disabled": true,
          "settings": {
            "button_primary_label": "Root Analysis",
            "button_primary_style": "primary",
            "button_primary_link": "shopify://pages/root-analysis-monitoring",
            "button_secondary_label": "Soil Analysis",
            "button_secondary_style": "secondary",
            "button_secondary_link": "shopify://pages/soil-analysis"
          }
        }
      },
      "block_order": [
        "subheading_qi6RzK",
        "heading_mggczd",
        "description_eDcWLg",
        "button_GEmYDh"
      ],
