    "rich_text_fzUR77": {
      "type": "rich-text",
      "blocks": {
        "heading_GKEeiz": {
          "type": "heading",
          "settings": {
            "heading_text": "Advanced Truffle Climate Map",
            "heading_size": "h2",
            "enable_h1_tag": false
          }
        },
        "subheading_zzn7gg": {
          "type": "subheading",
          "settings": {
            "subheading_text": "Pinpoint where truffles can thrive—before you plant."
          }
        },
        "description_CpWHrA": {
          "type": "description",
          "settings": {
            "description_text": "<p>Built on our original interactive map and engineered specifically for truffles, the <strong>Advanced Truffle Climate Map</strong> further includes these features: </p><ul><li><strong>Street-level resolution,</strong></li><li><strong>Dense climate data points</strong>, and </li><li><strong>Search-by-address</strong></li></ul><p>It includes <strong>historical climate conditions</strong> and <strong>50-year climate-change scenarios</strong>, translating complex microclimate data into <strong>clear, site-level guidance</strong>—so you invest where production potential is highest for <em>Tuber melanosporum</em>. With this map, you can be assured your truffle orchard location will remain climatically suitable for truffles for at least the next 50 years, even under the worst-case climate change scenario.</p>"
          }
        }
      },
      "block_order": [
        "heading_GKEeiz",
        "subheading_zzn7gg",
        "description_CpWHrA"
      ],
