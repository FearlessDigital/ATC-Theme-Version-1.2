        "heading_xRWXzq": {
          "type": "heading",
          "settings": {
            "heading_text": "The only way to really know what’s happening with your truffle mycorrhiza",
            "heading_size": "h2",
            "enable_h1_tag": false
          }
        },
        "description_3wkBCz": {
          "type": "description",
          "settings": {
            "description_text": "<p>Truffles are born from microscopic root tips. Long before you ever harvest a truffle, the real story is happening underground—where the truffle fungus colonizes your tree roots, competes with other fungi, and either establishes a strong foothold… or quietly disappears.</p><p>American Truffle Company’s Root Analysis Service gives you a clear, scientific view of that invisible world—every year—so you can protect your investment and manage your orchard based on data, not guesswork.</p>"
          }
        },
        "button_ctjAGn": {
