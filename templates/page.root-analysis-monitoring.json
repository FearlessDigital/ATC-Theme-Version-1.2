    "image_with_text_fHbNb3": {
      "type": "image-with-text",
      "blocks": {
        "heading_nk4Ath": {
          "type": "heading",
          "settings": {
            "heading_text": "Understand how your orchard is really doing",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_66kNiM": {
          "type": "description",
          "settings": {
            "description_text": "<p>From the outside, two orchards can look identical: same trees, same drip lines, same mowing pattern. Underground, however, they can be radically different—one with vigorous truffle mycorrhiza, the other quietly losing its target fungus to competitors.</p>"
          }
        },
        "subheading_Tw4K8K": {
          "type": "subheading",
          "settings": {
            "subheading_text": "ATC’s Root Analysis Service is how you tell which one you have."
          }
        },
        "description_ChfWCE": {
          "type": "description",
          "settings": {
            "description_text": "<p>If you would like to integrate annual root analysis into your orchard management—or bundle it with our broader scientific partnership—we invite you to get in touch with us to discuss options tailored to your land, your orchard, and your goals.</p>"
          }
