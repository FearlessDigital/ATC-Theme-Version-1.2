    "image_with_text_dwGeUe": {
      "type": "image-with-text",
      "blocks": {
        "heading_73GTKi": {
          "type": "heading",
          "settings": {
            "heading_text": "Confirm that the right truffle fungus is present and thriving",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "subheading_6GkWDc": {
          "type": "subheading",
          "settings": {
            "subheading_text": "A detailed microscope-based mycorrhiza analysis shows:"
          }
        },
        "description_zAjXGh": {
          "type": "description",
          "settings": {
            "description_text": "<ul><li>Whether your target truffle species (for example, Périgord black truffle, <em>Tuber melanosporum</em>) is actually colonizing the roots.</li><li>How extensively it is occupying root tips, which is strongly linked to fruiting potential.</li></ul><p>Without this, you’re effectively farming in the dark. There is little point in pouring time and money into irrigation, groundcover management, or pruning if the truffle fungus is not there—or not thriving—on the roots.</p>"
          }
        }
      },
      "block_order": [
        "heading_73GTKi",
