      "blocks": {
        "icon_with_text_item_DiDTYJ": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-identify.svg",
            "custom_code": "",
            "title": "Context review",
            "description": "<p>We start with key background: orchard location, age, species planted, management history, and any concerns (for example, slow development, inconsistent brûlé formation, unusual weather events).</p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_ezUHUE": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-prescreening.svg",
            "custom_code": "",
            "title": "Sampling plan",
            "description": "<p>We design or confirm a sampling strategy—how many trees, which zones of the orchard, and how often. For many orchards, an annual sampling of a representative subset of trees provides an excellent balance between cost and insight; in critical phases (such as years 3–7 after planting), more frequent testing can be justified.</p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_P8dXit": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-collection.svg",
            "custom_code": "",
            "title": "Root collection",
            "description": "<p>We provide training videos on how to collect viable roots to help you collect root samples, following a defined protocol to avoid damaging mycorrhiza and to ensure enough fine root tips are available for analysis.</p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_CGbrPP": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-flask.svg",
            "custom_code": "",
            "title": "Laboratory analysis",
            "description": "<p>Samples are examined under the microscope and, where warranted, supplemented with molecular analysis to confirm species identities or quantify specific fungi.</p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_bUfimE": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-exploratory.svg",
            "custom_code": "",
            "title": "Report & review session",
            "description": "<p>An ATC expert will report the findings, review the results, answer questions, and discuss management implications with you. You will also receive the analysis data in a report.  </p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_4Miwc3": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
