        "description_zWbMVm": {
          "type": "description",
          "settings": {
            "description_text": "<p>From global truffle research and ATC’s own orchards and partner network, three reasons stand out for testing roots every year, not just once:</p>"
          }
        }
      },
      "block_order": [
