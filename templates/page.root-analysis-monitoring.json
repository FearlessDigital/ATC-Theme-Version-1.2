    "rich_text_V4FyTd": {
      "type": "rich-text",
      "blocks": {
        "heading_Xn8gmM": {
          "type": "heading",
          "settings": {
            "heading_text": "Whom is the Root Analysis Service for?",
            "heading_size": "h2",
            "enable_h1_tag": false
          }
        },
        "description_CbLiPK": {
          "type": "description",
          "settings": {
            "description_text": "<ul><li><strong>Established truffle orchard owners </strong>(with or without ATC partnership) who need to understand why an orchard is underperforming—or to confirm that it is on the right trajectory.</li><li><strong>New truffle projects </strong>that want an early baseline on root colonization in the first few years after planting.</li><li><strong>ATC partner growers </strong>automatically have this service included in the partnership program.</li></ul><p><strong>If you are investing years and significant capital into a truffle orchard, annual root analysis is not a luxury—it’s a key part of responsible risk management.</strong></p>"
          }
        },
        "button_kCEBhE": {
          "type": "button",
          "settings": {
            "button_primary_label": "Contact Us",
