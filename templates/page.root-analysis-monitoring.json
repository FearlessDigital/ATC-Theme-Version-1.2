      }
    },
    "icon_with_text_KFmUfp": {
      "type": "icon-with-text",
      "blocks": {
        "icon_with_text_item_JgQpVY": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-graph1.svg",
            "custom_code": "",
            "title": "Sampling guidance or protocol",
            "description": "<p>We provide clear instructions (or direct support, depending on service level) on how and where to collect representative root samples from your orchard, so the results actually reflect orchard status rather than one random tree.</p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_jVrQFR": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-assesment.svg",
            "custom_code": "",
            "title": "Microscopic mycorrhiza assessment",
            "description": "<p>Specialist technicians examine root tips under the microscope to:</p><ul><li>Confirm the presence of your target truffle species’ mycorrhiza.</li><li>Estimate the level and quality of colonization (for example, proportion of colonized root tips, development stage).</li><li>Note signs of stress or poorly developed mycorrhiza.</li></ul>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_BGhD47": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-identify.svg",
            "custom_code": "",
            "title": "Target vs. non-target fungal identification",
            "description": "<p>Where appropriate, we assess the presence and relative abundance of other ectomycorrhizal fungi on the roots, including potentially competing or contaminant species. In selected cases, DNA-based methods may be used to clarify species identity if warranted.</p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_CKfcwm": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-exploratory.svg",
            "custom_code": "",
            "title": "Interpretation against ATC’s global benchmarks",
            "description": "<p>The raw numbers only tell part of the story. We interpret your results in the context of:</p><ul><li>Orchard age</li><li>Species planted (Périgord, Burgundy, etc.)</li><li>Climate and region</li><li>Tree species</li><li>Soil and irrigation context</li></ul><p>American Truffle Company and our scientific partner Mycorrhizal Systems Ltd. have built one of the largest unified datasets of truffle cultivation sites globally, across diverse climates and soils. That allows us to translate root data into realistic expectations and practical recommendations.</p>",
            "label": "",
            "link": ""
          }
        },
        "icon_with_text_item_jdw6b7": {
          "type": "icon_with_text_item",
          "settings": {
            "icon_source": "image",
            "theme_library_icon": "happy",
            "icon_image": "shopify://shop_images/icon-recommendations.svg",
            "custom_code": "",
            "title": "Actionable recommendations",
            "description": "<p>You receive a concise, decision-oriented report that may address, for example:</p><ul><li>Whether colonization is on track for orchard age.</li><li>If contamination is a concern, and what to do about it.</li><li>Whether irrigation, groundcover, or nutrient management should be adjustedin light ofmycorrhiza status.</li></ul><p>The aim is always the same: to increase the probability of strong, consistent truffle production over the life of the orchar</p>",
            "label": "",
            "link": ""
          }
        }
      },
