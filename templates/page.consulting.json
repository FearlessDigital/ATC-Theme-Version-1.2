    "multi_columns_zJyHWb": {
      "type": "multi-columns",
      "blocks": {
        "image_column_kP8pED": {
          "type": "image_column",
          "settings": {
            "image_column_image": "shopify://shop_images/Consulting_Field_L.jpg",
            "title": "Understand your production pattern, tree by tree",
            "description": "<p>In a producing orchard, our consulting focuses on building a detailed picture of where and how truffles are appearing:</p><ul><li>Mapping productive vs. non-productive trees over several seasons.</li><li>Identifying consistent “hot” and “cold” zones within the orchard.</li><li>Relating production patterns to soil, slope, irrigation lines, tree vigor, and root analysis results.</li></ul><p>A site visit lets us walk the orchard with your production maps in hand, observing micro-variations that simply don’t show up in satellite images or spreadsheets.</p>",
            "btn_label": "",
            "btn_link": ""
          }
        },
        "image_column_VBpfMY": {
          "type": "image_column",
          "settings": {
            "image_column_image": "shopify://shop_images/Consulting_Field_M.jpg",
            "title": "Increase the percentage of trees that produce",
            "description": "<p>Using ATC’s global dataset of truffle orchards, our deep understanding of truffle mycorrhiza dynamics, and insights from our own scientific research that’s unavailable in the public domain, we help you:</p><ul><li>Identify what differentiates productive trees or zones from non-productive ones on your property.</li><li>Prioritize interventions—such as changes in irrigation, groundcover, pruning, or soil amendments—that are most likely to bring additional trees into production. We also tap into our proprietary know-how to recommend interventions that aren’t part of public knowledge.</li><li>Integrate targeted root and soil testing to validate that management changes are having the desired effect underground.</li></ul><p>The aim is to move beyond “a lucky patch of trees” to a <strong>deliberately optimized orchard</strong> where a higher percentage of trees contribute to your yearly harvest.</p>",
            "btn_label": "",
            "btn_link": ""
          }
        },
        "image_column_a64DPK": {
          "type": "image_column",
          "settings": {
            "image_column_image": "shopify://shop_images/Consulting_Field_R.jpg",
            "title": "Enhance quality, consistency, and long-term productivity",
            "description": "<p>Beyond simply increasing the number of producing trees, consulting and site visits can help you:</p><ul><li>Improve truffle quality by fine-tuning harvest timing, handling, and storage.</li><li>Reduce year-to-year volatility in yield by understanding what drives good and bad seasons on your site.</li><li>Extend the productive life of the orchard through better-informed management decisions.</li></ul><p>We combine what we see in your orchard with patterns from other producing sites in our network, so you benefit from lessons learned across many regions, not just your own.</p>",
            "btn_label": "",
            "btn_link": ""
          }
        }
      },
      "block_order": [
        "image_column_kP8pED",
        "image_column_VBpfMY",
        "image_column_a64DPK"
      ],
