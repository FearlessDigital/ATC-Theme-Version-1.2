    "image_with_text_Ky4pCx": {
      "type": "image-with-text",
      "blocks": {
        "heading_Rcc9VH": {
          "type": "heading",
          "settings": {
            "heading_text": "Why you need annual soil analysis",
            "heading_size": "h2",
            "enable_h1_tag": false
          }
        },
        "description_Jk883k": {
          "type": "description",
          "settings": {
            "description_text": "<p>A one-time soil test before planting isn’t enough. Irrigation water, lime, fertilizers, organic matter, and even climate shifts continually change your soil, and <strong>soil condition is a major driver of truffle mycorrhiza decline</strong>. Annual soil analysis lets you proactively keep conditions in the ideal range for truffles, creating the best possible environment for truffle formation.</p>"
          }
        }
      },
      "block_order": [
        "heading_Rcc9VH",
        "description_Jk883k"
      ],
