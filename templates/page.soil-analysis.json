      "blocks": {
        "heading_RgfgA4": {
          "type": "heading",
          "settings": {
            "heading_text": "Protect your orchard from the ground up",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_zL9DNU": {
          "type": "description",
          "settings": {
            "description_text": "<p>Two orchards can look identical from above: same trees, same irrigation lines, same management routines. Yet below the surface, their soils can be very different—one steadily moving toward optimal truffle conditions, the other drifting away.</p><p>ATC’s Soil Analysis Service helps you understand which orchard you are running and what to do next.</p><p>If you would like to integrate annual soil analysis into your truffle project—or combine it with our Root Analysis and broader scientific partnership—we invite you to contact us to explore options tailored to your land, your orchard, and your goals.</p>"
          }
        }
      },
