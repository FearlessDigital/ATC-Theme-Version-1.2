    "image_with_text_68rAEp": {
      "type": "image-with-text",
      "blocks": {
        "heading_eJmDUg": {
          "type": "heading",
          "settings": {
            "heading_text": "Catch structural, salinity, and moisture-related issues early",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_rCKGAB": {
          "type": "description",
          "settings": {
            "description_text": "<p>Soil is not just chemistry—it is also structure and salinity. Heavy or compacted soils, excessive clay, poor drainage, and salt or sodium buildup from irrigation water can all affect truffle production. Problems often develop gradually and are hard to see from the surface.</p>"
          }
        },
        "subheading_wTV3m9": {
          "type": "subheading",
          "settings": {
            "subheading_text": "Annual soil testing helps you:"
          }
        },
        "description_4PaK6w": {
          "type": "description",
          "settings": {
            "description_text": "<ul><li>Detect salinity or sodium issues before they harm roots or mycorrhiza. </li><li>Identify compaction or drainage concerns that require management changes. </li><li>Fine-tune irrigation and groundcover practices to support both trees and truffles. </li></ul>"
          }
        }
      },
      "block_order": [
        "heading_eJmDUg",
        "description_rCKGAB",
        "subheading_wTV3m9",
        "description_4PaK6w"
