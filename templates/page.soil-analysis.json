    "rich_text_dKtLUk": {
      "type": "rich-text",
      "blocks": {
        "heading_tVD8DQ": {
          "type": "heading",
          "settings": {
            "heading_text": "What the Soil Analysis Service includes",
            "heading_size": "h2",
            "enable_h1_tag": false
          }
        },
        "description_Q7UjQE": {
          "type": "description",
          "settings": {
            "description_text": "<p>Our Soil Analysis Service is tailored for Périgord black truffle orchards and prospective truffle sites. We focus on the soil metrics that actually matter for <em>Tuber melanosporum </em>and related truffle species, then interpret them through the lens of ATC’s truffle-specific science.</p><p>The service is structured so that annual testing becomes a straightforward habit, not a one-off project.</p>"
          }
        },
        "button_mjVMG3": {
