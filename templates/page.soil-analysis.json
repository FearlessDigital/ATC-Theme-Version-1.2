    "image_with_text_fxT8aK": {
      "type": "image-with-text",
      "blocks": {
        "heading_byQixW": {
          "type": "heading",
          "settings": {
            "heading_text": "Whom the Soil Analysis Service is for",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_UBfcPJ": {
          "type": "description",
          "settings": {
            "description_text": "<p>This service is designed for:</p><ul><li><strong>Prospective truffle growers </strong>who want to verify and refine soil conditions before establishing a new orchard.</li><li><strong>Existing truffle orchard owners </strong>who wish to optimize their soil condition and increase yield.</li><li><strong>ATC partner growers </strong>already have the Soil Analysis Service included in the partnership program.</li></ul><p>If you are committing years and significant effort and capital to a truffle orchard, annual soil analysis is not optional—it is a core part of protecting that investment.</p>"
          }
        }
      },
      "block_order": [
        "heading_byQixW",
