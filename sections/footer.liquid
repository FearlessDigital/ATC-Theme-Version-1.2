        {
          "type": "select",
          "id": "block_width",
          "label": "t:general.settings.block_width.label",
          "options": [
            {
              "value": "2",
              "label": "t:general.settings.block_width.options_2.label"
            },
            {
              "value": "3",
              "label": "t:general.settings.block_width.options_3.label"
            },
            {
              "value": "4",
              "label": "t:general.settings.block_width.options_4.label"
            },
            {
              "value": "6",
              "label": "t:general.settings.block_width.options_6.label"
