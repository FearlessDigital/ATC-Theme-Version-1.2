{% liquid
  assign section_id = section.id | md5 | truncate: 12, ''
  if settings.using_primary_button
    assign menu_color = 'menu__item--color'
  endif
%}
{%- if section.blocks.size > 0 -%}
  {%- render 'section-padding-collapse' -%}
  <footer class="footer-section section section--vertical color-{{- section.settings.color_scheme }} background" data-ui-component="Section Footer">
  <div data-animate="regular-section" class="js-animate d-grid c-gap-fix-m-sm r-gap-fix-4xl-lg r-gap-scale-3xl p-relative w-100 {{ section.settings.enable_fullwidth | default: 'ctnr' | replace: 'true', '' }}" style="--gtc-equal-sm: 2; --gtc-equal-lg: 12">
    {%- render 'layout-grid-placeholder', class: 'footer__layout-grid' -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'store_information' -%}
          {% liquid
            assign content_position = 'center-lg'
            if block.settings.block_alignment contains 'bottom-lg'
              assign content_position = 'end-lg'
            elsif block.settings.block_alignment contains 'top-lg'
              assign content_position = 'start-lg'
            endif
          %}
          <div class="footer__item zi-1 p-relative d-flex fd-column gap-m {{ block.settings.block_alignment }}" style="--item-clm-span: {{ block.settings.block_width }}; --gc-sm: span 2" {{ block.shopify_attributes }}>
            {% if block.settings.logo != blank %}
              <div class="footer__logo" style="--logo-width: {{ block.settings.logo_max_width }}px">
                {%- assign image_size_2x = block.settings.logo_max_width | times: 2 -%}
                <img
                  srcset="{{ block.settings.logo | image_url: width: block.settings.logo_max_width }} 1x, {{ block.settings.logo | image_url: width: image_size_2x }} 2x"
                  src="{{ block.settings.logo | image_url: width: block.settings.logo_max_width }}"
                  loading="lazy"
                  class="logo"
                  width="{{ block.settings.logo.width }}"
                  height="{{ block.settings.logo.height }}"
                  alt="{{ block.settings.logo.alt | default: shop.name | escape }}"
                >
              </div>
            {% endif %}
            <div class="h6 hide-empty">{{- block.settings.heading | escape -}}</div>
            <div class="rte hide-empty">{{- block.settings.description -}}</div>
            <div class="{{ block.settings.show_social_icon | default: 'd-none' | replace: 'true', '' }}">
              {%- render 'socials', classes: content_position, class: menu_color -%}
            </div>
            {%- if shop.features.follow_on_shop? and block.settings.show_follow_on_shop -%}
              <div class="">
                {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
                {% # theme-check-disable %}
                {{ shop | login_button: action: 'follow' }}
                {% # theme-check-enable %}
              </div>
            {%- endif -%}
          </div>
        {%- when 'newsletter' -%}
          {% liquid
            assign content_position = 'center-lg'
            if block.settings.block_alignment contains 'bottom-lg'
              assign content_position = 'end-lg'
            elsif block.settings.block_alignment contains 'top-lg'
              assign content_position = 'start-lg'
            endif
          %}
          <div class="footer__item zi-1 p-relative d-flex fd-column gap-m {{ block.settings.block_alignment }}" style="--item-clm-span: {{ block.settings.block_width }}; --gc-sm: span 2" {{ block.shopify_attributes }}>
            <div class="footer__newsletter d-flex fd-column gap-m">
              <span class="h6 hide-empty">{{- block.settings.heading | escape -}}</span>
              <div class="rte hide-empty">{{- block.settings.description -}}</div>
              {%- render 'newsletter-form', block: block, alignment_class: content_position, button_label: block.settings.submit_button -%}
            </div>
          </div>
        {%- when 'menu' -%}
          {% if block.settings.main_menu != blank or block.settings.heading != blank %}
            {% liquid
              assign content_position = 'center-lg'
              if block.settings.block_alignment contains 'bottom-lg'
                assign content_position = 'end-lg'
              elsif block.settings.block_alignment contains 'top-lg'
                assign content_position = 'start-lg'
              endif
            %}
            <div class="footer__item zi-1 p-relative d-flex fd-column gap-m" style="--item-clm-span: {{ block.settings.block_width }}" {{ block.shopify_attributes }}>
              <sht-clps-rgn
              class="d-flex fd-column gap-m {{ block.settings.show_collapsible_mobile | default: '' | replace: true , 'footer__menu' }} {{ block.settings.block_alignment }}"
              data-properties='{"isCollapsibleOnDesktop":false, "isCollapsibleOnMobile":{{ block.settings.show_collapsible_mobile }}, "isExpandOnMobile": {{ block.settings.expand_collapsible_by_default }}, "ariaDescribedby": "clsbeTgr-{{ section_id }}-{{ forloop.index }}", "ariaControls": "clsbeCtt-{{ section_id }}-{{forloop.index}}"}'
              >
                <button id="clsbeTgr-{{ section_id }}-{{ forloop.index }}" class="region-trigger m-zero js-collapsible-region-trigger w-100 d-flex between-xs wb-break-word c-pointer p-zero bg-transparent b-zero h6 {{ content_position }}"
                aria-controls="clsbeCtt-{{ section_id }}-{{forloop.index}}"
                aria-expanded="true">
                  {% if block.settings.heading != blank %}
                    {{- block.settings.heading | escape -}}
                  {% else %}
                    {{- block.settings.main_menu.title -}}
                  {% endif %}
                  <span class="toggle__icon d-flex d-none-lg middle-xs center-xs">
                    {% render 'icon-toggle', icon_arrow: 'icon-caret-down d-none icon icon-fix-m', class_first: 'toggle__icon--plus p-absolute d-none icon icon-fix-m', class_second: 'toggle__icon--minus p-absolute d-none icon icon-fix-m' %}
                  </span>
                </button>
                <div id="clsbeCtt-{{ section_id }}-{{ forloop.index }}" class="region-content js-collapsible-region-content o-hidden" role="region" tabindex="-1" aria-describedby="clsbeTgr-{{ section_id }}-{{forloop.index}}">
                  {%- if block.settings.main_menu -%}
                    <ul class="ls-none">
                      {%- for link in block.settings.main_menu.links -%}
                        <li class="menu__item">
                          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %} class="footer__menu-link d-flex middle-xs w-100 {{ menu_color }} {{ link.current | default: '' | replace: 'true', 'footer__link--active' }}">
                            {{- link.title -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </sht-clps-rgn>
            </div>
          {% endif %}
        {%- when 'custom_text' -%}
          {%- if block.settings.heading != blank or block.settings.description != blank -%}
            <div class="footer__item zi-1 d-flex fd-column gap-m {{ block.settings.block_alignment }}" style="--item-clm-span: {{ block.settings.block_width }}; --gc-sm: span 2" {{ block.shopify_attributes }}>
              <span class="h6 hide-empty">{{- block.settings.heading | escape -}}</span>
              <div class="rte hide-empty">{{- block.settings.description -}}</div>
            </div>
          {%- endif -%}
        {%- when 'spacer' -%}
          <div class="footer__item zi-1 d-block-lg d-none" style="--item-clm-span: {{ block.settings.block_width }}" {{ block.shopify_attributes }}></div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
    <div class="copyright">
      &copy; {{ 'now' | date: '%Y' }} American Truffle Company. All rights reserved.
    </div>
  </footer>
{%- endif -%}
