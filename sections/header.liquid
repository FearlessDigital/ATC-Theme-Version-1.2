{%- comment -%}
  ============================================================================
  STEP 1 OF 4 — ATC Zone Detection (v1.8)
  Runs before any HTML. Assigns atc_nav_zone and atc_active_menu.
  ============================================================================
{%- endcomment -%}
{%- liquid
  assign atc_path        = request.path
  assign atc_nav_zone    = 'default'
  assign atc_active_menu = 'main-menu'

  assign atc_grower_paths = '/pages/growers,/pages/partnership,/pages/consulting,/pages/land-search-guidance,/pages/root-analysis-monitoring,/pages/soil-analysis,/pages/truffle-fundamentals,/pages/our-technology,/blogs/news,/pages/about,/pages/contact'
  assign atc_buyer_paths  = '/collections/,/products/,/pages/wholesale,/pages/seasonal-availability,/pages/find-a-retailer,/pages/truffle-buyers'

  assign atc_page_url = content_for_header | split: '"pageurl":"' | last | split: '"' | first | url_decode
  assign atc_has_z_buyers = false
  if atc_page_url contains 'z=buyers'
    assign atc_has_z_buyers = true
  endif

  assign atc_grower_array = atc_grower_paths | split: ','
  for atc_gpath in atc_grower_array
    if atc_path contains atc_gpath
      assign atc_nav_zone = 'growers'
      break
    endif
  endfor

  if atc_nav_zone == 'default'
    assign atc_buyer_array = atc_buyer_paths | split: ','
    for atc_bpath in atc_buyer_array
      if atc_path contains atc_bpath
        assign atc_nav_zone = 'buyers'
        break
      endif
    endfor
  endif

  if atc_path contains '/blogs/news/tagged/recipes'
    if atc_has_z_buyers
      assign atc_nav_zone = 'buyers'
    else
      assign atc_nav_zone = 'growers'
    endif
  endif

  if atc_path contains '/blogs/news'
    unless atc_path contains '/blogs/news/tagged/recipes'
      unless atc_path contains '/blogs/news/tagged/atc-in-the-media'
        if atc_has_z_buyers
          assign atc_nav_zone = 'buyers'
        endif
      endunless
    endunless
  endif

  if atc_path contains '/blogs/news/tagged/atc-in-the-media'
    if atc_has_z_buyers
      assign atc_nav_zone = 'buyers'
    else
      assign atc_nav_zone = 'growers'
    endif
  endif

  case atc_nav_zone
    when 'growers'
      if section.settings.atc_growers_menu != blank
        assign atc_active_menu = section.settings.atc_growers_menu
      else
        assign atc_active_menu = 'growers-navigation'
      endif
    when 'buyers'
      if section.settings.atc_buyers_menu != blank
        assign atc_active_menu = section.settings.atc_buyers_menu
      else
        assign atc_active_menu = 'buyers-navigation'
      endif
    else
      assign atc_active_menu = ''
  endcase

  assign atc_show_zone_bar = false
  if atc_nav_zone == 'growers' and section.settings.atc_show_growers_zone_bar
    assign atc_show_zone_bar = true
  endif
  if atc_nav_zone == 'buyers' and section.settings.atc_show_buyers_zone_bar
    assign atc_show_zone_bar = true
  endif
-%}
{%- comment -%} END STEP 1 — ATC Zone Detection {%- endcomment -%}

{% liquid
  assign menu_open_type = section.settings.dropdown_menu_open_type
  if settings.using_primary_button
    assign menu_color = 'menu__item--color'
    assign link_custom_color = 'link--custom-color'
  endif
%}
{%- capture header_icon_search -%}
  <div class="header__icon--search d-flex middle-xs">
    <a role="button" href="{{ routes.search_url }}" data-event="{{ settings.search_type }}" data-js-file-id="component-predictive-search-js-file" data-js-file="{{ 'component-predictive-search.js' | asset_url }}" {% if settings.search_type == 'drawer' %} onclick="event.preventDefault();" {% endif %} aria-label="{{ 'accessibility.search' | t }}" class="btn-search header-icon js-search-open-trigger {{ menu_color }}" role="button" aria-haspopup="dialog">
      {% render 'icon-search', class: 'header__button--icon d-none icon icon-fix-xl' %}
      <span class="header__button--text d-none {{ section.settings.button_text_size }}">
        {{ 'general.search.search' | t }}
      </span>
    </a>
  </div>
{%- endcapture -%}
{%- capture menu_drawer_opner -%}
  <sht-menu-drwer-opner class="d-block header__icons {{ section.settings.enable_drawer | default: 'd-none-lg' | replace: true, '' }}" hidden>
    <button type="button" aria-expanded="false" aria-label="{{ 'accessibility.toggle_navigation' | t }}" aria-controls="menuDrawer" class="btn header-icon {{ menu_color }} js-menu-drawer-trigger">
      {% render 'icon-menu', class: 'icon icon-fix-xl' %}
    </button>
  </sht-menu-drwer-opner>
{%- endcapture -%}
{%- capture header_localization -%}
    {%- if section.settings.show_currency_selector != 'not-use' and localization.available_countries.size > 1 -%}
      <sht-localization class="d-flex {{ section.settings.show_currency_selector }}" data-js-file-id="component-switcher-js-file" data-js-file="{{ 'component-switcher.js' | asset_url }}" data-section-id="shopify-section-country-switcher" data-url="{{ routes.root_url }}?section_id=country-switcher">
        <button type="button" class="f-extra js-switcher-btn fs-menu-item-small btn-localization focus-state w-100 c-pointer b-zero">
          <span class="country-flag flex-0-auto">
            {{- localization.country | image_url: width: 20, height: 20 | image_tag: widths: '350', sizes: '100vw', class: 'country-list--flag br-50p of-cover h-100', loading: 'lazy', fetchpriority: 'auto', decoding: 'async' -}}
          </span>
          <span class="country-name">
            {{ localization.country.name }}
            <span>•</span>
          </span>
          <span class="country-currency">
            {{ localization.country.currency.iso_code }}
            {{ localization.country.currency.symbol }}
          </span>
          <span class="toggle__icon d-flex middle-xs center-xs select__icon select-icon-{{- settings.toggle_icon -}}">
            {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-m icon', class_first: 'toggle__icon--plus icon-fix-m icon p-absolute', class_second: 'toggle__icon--minus icon-fix-m icon p-absolute' %}
          </span>
        </button>
      </sht-localization>
    {%- endif -%}
    {%- if section.settings.show_language_selector and localization.available_languages.size > 1 -%}
      <sht-localization class="d-flex" data-js-file-id="component-switcher-js-file" data-js-file="{{ 'component-switcher.js' | asset_url }}" data-section-id="shopify-section-language-switcher" data-url="{{ routes.root_url }}?section_id=language-switcher">
        <button type="button" class="f-extra js-switcher-btn fs-menu-item-small btn-localization focus-state w-100 c-pointer b-zero">
          {{- localization.language.iso_code | upcase -}}
          <span class="toggle__icon d-flex middle-xs center-xs select__icon select-icon-{{- settings.toggle_icon -}}">
            {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-m icon', class_first: 'toggle__icon--plus icon-fix-m icon p-absolute', class_second: 'toggle__icon--minus icon-fix-m icon p-absolute' %}
          </span>
        </button>
      </sht-localization>
    {%- endif -%}
{%- endcapture -%}
{%- render 'layout-grid-placeholder', class: 'section-header header__layout-grid' -%}
<sht-header-sticky class="header-sticky d-block" data-sticky-state="{{- section.settings.header_sticky -}}"
  style="--sticky-bg-opacity: {{ section.settings.sticky_background_opacity | times: 1.0 |  divided_by: 100 }};
         --transparent-bg-opacity: {{ section.settings.transparent_background_opacity | times: 1.0 |  divided_by: 100 }}">
  <sht-header
  data-color="color-{{- section.settings.color_scheme }}"
  data-color-sticky="color-{{- section.settings.sticky_color_scheme }}"
  data-color-transparent="color-{{- section.settings.transparent_color_scheme }}"
  class="js-header section-header zi-5 background p-relative_ d-block {{ section.settings.sticky_enable_glass_effects | replace: 'true', 'sticky-background-blur' }} color-{{- section.settings.color_scheme }} {{ section.settings.button_style_desktop }} {{ section.settings.button_style_mobile }} {{ section.settings.transparent_enable_glass_effects | replace: 'true', 'transparent-bg-blur' }}"
  data-ui-component="Header Section"
  data-menu-dropdown-open-type="{{- section.settings.dropdown_menu_open_type -}}"
  data-nav-zone="{{ atc_nav_zone }}"
  data-nav-blog-slug="{{ atc_blog_slug }}"
  >
    {%- comment -%}
      ========================================================================
      STEP 3 OF 4 — ATC Zone Indicator Bar
      Placed inside sht-header, ABOVE the <header> row.
      ========================================================================
    {%- endcomment -%}
    {%- if atc_show_zone_bar -%}
      <div class="atc-zone-bar atc-zone-bar--{{ atc_nav_zone }}"
           role="note"
           aria-label="Site section indicator">
        <div class="atc-zone-bar__inner">

          {%- if atc_nav_zone == 'growers' -%}
            <span class="atc-zone-bar__eyebrow">Grower Portal</span>
            <span class="atc-zone-bar__divider" aria-hidden="true">·</span>
            <span class="atc-zone-bar__message">
              Scientific cultivation support &amp; services
            </span>
            <a href="/collections/all"
               class="atc-zone-bar__cta"
               aria-label="Switch to buyer section">
              Looking to buy fresh truffles?
              <svg class="atc-zone-bar__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

          {%- elsif atc_nav_zone == 'buyers' -%}
            <span class="atc-zone-bar__eyebrow">Truffle Shop</span>
            <span class="atc-zone-bar__divider" aria-hidden="true">·</span>
            <span class="atc-zone-bar__message">
              Ultra-fresh, farm-to-door truffle delivery
            </span>
            <a href="/pages/growers"
               class="atc-zone-bar__cta"
               aria-label="Switch to grower section">
              Interested in growing truffles?
              <svg class="atc-zone-bar__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}

        </div>
      </div>
    {%- endif -%}
    {%- comment -%} END STEP 3 — ATC Zone Bar {%- endcomment -%}

    <header class="header header-mobile--{{- section.settings.header_layout_mobile }} d-grid gap-xs gap-m-lg p-relative_ {{ link_custom_color }} {{ section.settings.enable_fullwidth | default: 'ctnr' | replace: 'true', '' }}" style="--gtc-equal-lg: 12">
      {%- unless section.settings.header_layout_mobile == 'menu-right' -%}
        <div class="header-icon-start d-flex middle-xs d-none-lg">
          {{- menu_drawer_opner -}}
          {%- if section.settings.header_layout_mobile == 'logo-center' -%}
            {{- header_icon_search -}}
          {%- endif -%}
        </div>
      {%- endunless -%}
        {%- render 'header-logo',
          logo_width_desktop: section.settings.logo_max_width_desktop,
          logo_width_mobile: section.settings.logo_max_width_mobile,
          sticky_logo_width_desktop: section.settings.sticky_logo_max_width_desktop
          sticky_logo_width_mobile: section.settings.sticky_logo_max_width_mobile
          transparent_logo_width_desktop: section.settings.transparent_logo_max_width_desktop
          transparent_logo_width_mobile: section.settings.transparent_logo_max_width_mobile
        -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vertical_menu' -%}
              {%- if block.settings.main_menu != blank -%}
                {%- comment -%} ATC: resolve menu for vertical_menu block {%- endcomment -%}
                {%- liquid
                  if atc_active_menu != blank
                    assign atc_render_menu = atc_active_menu
                  else
                    assign atc_render_menu = block.settings.main_menu
                  endif
                -%}
                <div class="header__item header__menu menu--vertical js-menu-drawer-content d-block-lg d-none" style="--item-clm-span: {{ block.settings.block_width }}" {{ block.shopify_attributes }}>
                  {%- render 'header-nav', block: block, main_list_class: 'fd-column', menu_open_type: menu_open_type, menu_color: menu_color, atc_render_menu: atc_render_menu -%}
                </div>
              {%- endif -%}
            {%- when 'horizontal_menu' -%}
              {%- if block.settings.main_menu != blank -%}
                {%- comment -%}
                  ================================================================
                  STEP 2 OF 4 — ATC Menu Override for horizontal_menu block
                  If zone detection found an active menu, use it.
                  Otherwise fall back to the block's own setting.
                  ================================================================
                {%- endcomment -%}
                {%- liquid
                  if atc_active_menu != blank
                    assign atc_render_menu = atc_active_menu
                  else
                    assign atc_render_menu = block.settings.main_menu
                  endif
                -%}
                <div class="header__item header__menu menu--horizontal js-menu-drawer-content d-flex-lg d-flex-xs d-none" style="--item-clm-span: {{ block.settings.block_width }}" {{ block.shopify_attributes }}>
                  {%- render 'header-nav', block: block, main_list_class: 'middle-xs gap-3xs', menu_open_type: menu_open_type, menu_color: menu_color, atc_render_menu: atc_render_menu -%}
                </div>
              {%- endif -%}
            {%- when 'spacer' -%}
              <div class="header__item header__spacer d-block-lg d-none" style="--item-clm-span: {{ block.settings.block_width }}" {{ block.shopify_attributes }}>
              </div>
            {%- when 'social_media' -%}
              {% liquid
                assign enable_social_drawer = block.settings.show_in_menu_drawer
              %}
              {% capture social_media %}
                {%- render 'socials', classes: block.settings.block_alignment, class: menu_color -%}
              {% endcapture %}
              <div class="header__item header__socials d-block-lg d-none" style="--item-clm-span: {{ block.settings.block_width }}" {{ block.shopify_attributes }}>
                {{ social_media }}
              </div>

            {%- when 'custom_text' -%}
              {%- if block.settings.text != blank -%}
                <div class="header__item js-menu-drawer-content header__custom-text d-block-lg d-none" style="--item-clm-span: {{ block.settings.block_width }}" {{ block.shopify_attributes }}>
                  <div class="header__text rte {{ block.settings.text_alignment }} {{ block.settings.show_in_menu_drawer | default: "d-none d-block-md" | replace: true, "" }}">
                    {{- block.settings.text -}}
                  </div>
                </div>
              {%- endif -%}
            {%- endcase -%}
        {%- endfor -%}
        <div class="header__utilities p-relative d-flex hide-empty end-lg top-lg middle-xs fw-wrap" style="--item-clm-span: {{ section.settings.utilities_width_desktop }}">
          <div class="header__localization d-none d-flex-lg fw-wrap hide-empty separate-icon p-relative">
            {{- header_localization -}}
          </div>
          {{- header_icon_search -}}
            <div class="header__icon--account {{ shop.customer_accounts_enabled | replace: 'true', 'd-block' | replace: 'false', 'd-none' }}">
              {%- if customer -%}
                <a aria-label="{{ 'customer.account_fallback' | t }}" href="{{ routes.account_url }}" class="header__account header__link header-icon {{ menu_color }}" aria-label="{{ customer.first_name }}" title="{{ customer.first_name }}">
                  {%- render 'icon-user-circle', class: 'header__button--icon d-none' -%}
                  <span class="header__button--text d-none {{ section.settings.button_text_size }}">
                    {{- 'general.search.account' | t -}}
                  </span>
                </a>
              {%- else -%}
                <a aria-label="{{- 'customer.log_in' | t -}}" href="{{- routes.account_login_url -}}" class="header__link header-icon {{ menu_color }}">
                  {%- render 'icon-user-circle', class: 'header__button--icon d-none' -%}
                  <span class="header__button--text d-none {{ section.settings.button_text_size }}">
                    {{- 'general.search.account' | t -}}
                  </span>
                </a>
              {%- endif -%}
            </div>
          <div class="header__icon--cart fs-body-xs">
            <div class="header-icon">
              <a
                role="button"
                data-event="{{ settings.cart_type }}"
                href="{{- routes.cart_url -}}"
                {%- if settings.cart_type == 'drawer' -%}
                  onclick="event.preventDefault();try { window.shtCartDrawer.openDrawer(this); } catch(err) { window.location.assign('{{ routes.cart_url }}');}"
                {%- endif -%}
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="shtCartDrawer"
                class="js-header-cart-status-btn p-relative {{ menu_color }} js-cart-drawer-trigger"
                id="headerCartStatus"
              >
                {%- render 'header-cart-status', class: 'header__button--icon d-none', button_text_size: section.settings.button_text_size, cart: cart, button_style:  -%}
              </a>
            </div>
          </div>
          {%- if section.settings.header_layout_mobile == 'menu-right' -%}
            {{- menu_drawer_opner -}}
          {%- endif -%}
        </div>
    </header>
  </sht-header>
</sht-header-sticky>
<!-- Menu Drawer -->
<sht-menu-drwer aria-hidden="true" id="menuDrawer" class="menu-drawer-wrapper js-menu-drawer drawer inset p-fixed drawer--left d-flex-xs no-focus-visible d-none-lg hidden-xs color-{{ section.settings.color_scheme }}" hidden tabindex="-1">
  <div class="drawer-overlay js-menu-drawer-overlay js-drawer-overlay p-absolute w-100 h-100 inset d-none-lg"></div>
  <sht-scroll-gradient-overlay class="drawer-wrapper drawer-content-container oy-scroll js-menu-drawer-wrapper js-drawer-wrapper p-relative zi-2 gradient-overlay--bottom gradient-overlay">
    <div class="drawer__header d-flex middle-xs between-xs gap-xs">
      <h2 class="drawer__heading h4 m-zero hidden-xs">{{ 'sections.header.drawer.title' | t }}</h2>
      <button class="drawer__btn-close js-menu-drawer-btn-close js-drawer-btn-close btn btn-icon btn-icon-l btn-tertiary" type="button" aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icon-x-mark' -%}
      </button>
    </div>
    <div class="drawer__body disable-scrollbars p-relative">
      <div class="js-menu-drawer-body js-scroll-element menu-drawer disable-scrollbars h-100 oy-scroll {{ link_custom_color }}">

      </div>
    </div>
    <div class="header-extra-info hide-empty p-relative d-flex fd-column p-sticky bottom-0 zi-6">
      {%- if enable_social_drawer -%}
        {{ social_media }}
      {%- endif -%}
      <div class="header__localization d-flex middle-xs hide-empty">
      {{ header_localization }}
      </div>
    </div>
  </sht-scroll-gradient-overlay>
</sht-menu-drwer>
<!-- Menu Drawer -->
<script type="application/ld+json">
  {"@context": "http://schema.org","@type": "Organization","name": {{- shop.name | json -}},{%- if section.settings.logo -%}"logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},{%- endif -%}"sameAs": [{{ settings.social_twitter_link | json }},{{ settings.social_facebook_link | json }},{{ settings.social_pinterest_link | json }},{{ settings.social_instagram_link | json }},{{ settings.social_tiktok_link | json }},{{ settings.social_tumblr_link | json }},{{ settings.social_snapchat_link | json }},{{ settings.social_youtube_link | json }},{{ settings.social_vimeo_link | json }}],"url": {{ request.origin | append: page.url | json }}}
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {"@context": "http://schema.org","@type": "WebSite","name": {{ shop.name | json }},"potentialAction": {"@type": "SearchAction","target": {{ potential_action_target | json }},"query-input": "required name=search_term_string"},"url": {{ request.origin | append: page.url | json }}}
  </script>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.header.name",
  "class": "js-section-header header-wrapper p-relative zi-8",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_fullwidth",
      "label": "t:general.settings.enable_fullwidth_content.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_layout_grid",
      "label": "t:sections.header.settings.show_layout_grid.label",
      "default": true,
      "info": "t:sections.header.settings.show_layout_grid.info"
    },
    {
      "type": "select",
      "id": "header_layout_mobile",
      "label": "t:sections.header.settings.layout_mobile.label",
      "options": [
        {
          "value": "menu-left",
          "label": "t:sections.header.settings.layout_mobile.options.logo_left_menu_left.label"
        },
        {
          "value": "menu-right",
          "label": "t:sections.header.settings.layout_mobile.options.logo_left_menu_right.label"
        },
        {
          "value": "logo-center",
          "label": "t:sections.header.settings.layout_mobile.options.logo_center_menu_left.label"
        }
      ],
      "default": "logo-center"
    },
    {
      "type": "select",
      "id": "dropdown_menu_open_type",
      "label": "t:sections.header.settings.dropdown_menu.label",
      "options": [
        {
          "value": "click",
          "label": "t:sections.header.settings.dropdown_menu.options.click.label"
        },
        {
          "value": "hover",
          "label": "t:sections.header.settings.dropdown_menu.options.hover.label"
        }
      ],
      "default": "hover",
       "info": "t:sections.header.settings.dropdown_menu.info"
    },
    {
      "type": "header",
      "content": "🌱 Audience Navigation — American Truffle Co."
    },
    {
      "type": "paragraph",
      "content": "Menus switch automatically based on which section of the site the visitor is browsing. The main menu is shown on the homepage and system pages only."
    },
    {
      "type": "text",
      "id": "atc_growers_paths",
      "label": "Grower zone URL paths",
      "default": "/pages/growers,/pages/partnership,/pages/consulting,/pages/land-search-guidance,/pages/root-analysis-monitoring,/pages/soil-analysis,/pages/truffle-fundamentals,/pages/our-technology,/pages/about,/pages/contact",
      "info": "Comma-separated list of URL paths that show the grower navigation. Do not include blog paths here — use the blog slug setting below."
    },
    {
      "type": "text",
      "id": "atc_buyers_paths",
      "label": "Buyer zone URL paths",
      "default": "/collections/,/products/,/pages/wholesale,/pages/seasonal-availability,/pages/find-a-retailer,/pages/truffle-buyers",
      "info": "Comma-separated list of URL paths that show the buyer navigation. Partial paths like /collections/ will match all sub-pages."
    },
    {
      "type": "text",
      "id": "atc_blog_slug",
      "label": "Shared blog slug",
      "default": "/blogs/news",
      "info": "The blog path shared between both zones. Zone is determined by the ?z= parameter. Defaults to grower zone when no parameter is present."
    },
    {
      "type": "link_list",
      "id": "atc_growers_menu",
      "label": "Growers Navigation Menu",
      "info": "Menu shown on grower zone pages."
    },
    {
      "type": "checkbox",
      "id": "atc_show_growers_zone_bar",
      "label": "Show zone indicator bar on Grower pages",
      "default": true,
      "info": "Displays the green 'Grower Portal' bar at the top of the header on grower zone pages. Turning this off hides the bar but the grower nav menu still switches correctly."
    },
