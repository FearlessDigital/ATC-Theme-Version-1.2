{% comment %} sections/recipe-grid.liquid {% endcomment %}

<section class="recipe-grid-section">

  <h2 class="recipe-grid-heading">
    {{ section.settings.heading_plain }}
    {% if section.settings.heading_link != blank %}
      <a href="{{ section.settings.heading_link }}" class="recipe-grid-heading-link">
        <em>{{ section.settings.heading_italic }}</em>
      </a>
    {% else %}
      <em>{{ section.settings.heading_italic }}</em>
    {% endif %}
  </h2>

  <div class="recipe-grid">
    {% for block in section.blocks %}
      
        <a class="recipe-card"
            href="{{ block.settings.link }}"
            {{ block.shopify_attributes }}
        >
        <div class="recipe-card__image-wrapper">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
              width="600"
              height="700"
              crop="center"
              class="recipe-card__image"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'recipe-card__placeholder' }}
          {% endif %}
        </div>
        <div class="recipe-card__body">
          <span class="recipe-card__category">{{ block.settings.category | default: 'Featured Recipe' }}</span>
          <h3 class="recipe-card__title">{{ block.settings.title }}</h3>
        </div>
      </a>
    {% endfor %}
  </div>

  {% if section.settings.button_label != blank and section.settings.button_link != blank %}
    <div class="recipe-grid-cta">
      <a href="{{ section.settings.button_link }}" class="recipe-grid-btn">
        {{ section.settings.button_label }}
      </a>
    </div>
  {% endif %}

</section>

<style>
  .recipe-grid-section {
    padding: {{ section.settings.section_padding_vertical }}px {{ section.settings.section_padding_horizontal }}px;
    background-color: {{ section.settings.background_color }};
    text-align: center;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* ── Heading ── */
  .recipe-grid-heading {
    font-size: clamp(22px, 3vw, 36px);
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 48px;
    line-height: 1.3;
  }

  .recipe-grid-heading-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .recipe-grid-heading-link:hover {
    opacity: 0.75;
  }

  /* ── Grid ── */
  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.card_gap }}px;
    margin-bottom: 48px;
  }

  @media (max-width: 768px) {
    .recipe-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .recipe-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Cards ── */
  .recipe-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: left;
    transition: opacity 0.25s ease;
  }

  .recipe-card:hover {
    opacity: 0.85;
  }

  .recipe-card__image-wrapper {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
    margin-bottom: 16px;
    aspect-ratio: 3 / 4;
    background-color: #f0f0f0;
  }

  .recipe-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .recipe-card:hover .recipe-card__image {
    transform: scale(1.03);
  }

  .recipe-card__placeholder {
    width: 100%;
    height: 100%;
  }

  .recipe-card__body {
    padding: 0 4px;
  }

  .recipe-card__category {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.category_color }};
    margin-bottom: 8px;
  }

  .recipe-card__title {
    font-size: clamp(15px, 1.5vw, 20px);
    font-family: Newsreader, serif;
    line-height: 1.3;
    letter-spacing: 0;
    color: {{ section.settings.title_color }};
    margin: 0;
    text-transform: {{ section.settings.title_case }};
  }

  /* ── CTA Button ── */
  .recipe-grid-cta {
    margin-top: 8px;
  }

  .recipe-grid-btn {
    display: inline-block;
    padding: 14px 36px;
    background-color: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    border: 2px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    font-weight: normal;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
    font-family: 'Lexend Zetta';
  }

  .recipe-grid-btn:hover {
    background-color: {{ section.settings.button_hover_bg }};
    color: {{ section.settings.button_hover_text_color }};
  }
</style>

{% schema %}
{
  "name": "Recipe Grid",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding_vertical",
      "label": "Top & Bottom Padding (px)",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Left & Right Padding (px)",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Section Width (px)",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_plain",
      "label": "Heading — Regular Text",
      "default": "For recipes and tips from top chefs"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading — Italic Text (linked)",
      "default": "visit our blog"
    },
    {
      "type": "url",
      "id": "heading_link",
      "label": "Italic Text Link URL"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Recipe Cards"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap Between Cards (px)",
      "min": 12,
      "max": 60,
      "step": 4,
      "default": 28
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Corner Radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 4
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Category Label Color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Recipe Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "title_case",
      "label": "Recipe Title Case",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "capitalize", "label": "Title Case" },
        { "value": "uppercase", "label": "ALL CAPS" },
        { "value": "lowercase", "label": "lowercase" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "See More Recipes"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link URL"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button Hover Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Corner Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "recipe",
      "name": "Recipe Card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Recipe Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category Label",
          "default": "Featured Recipe"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Recipe Title",
          "default": "Recipe Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to Blog Post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipe Grid",
      "blocks": [
        { "type": "recipe" },
        { "type": "recipe" },
        { "type": "recipe" }
      ]
    }
  ]
}
{% endschema %}